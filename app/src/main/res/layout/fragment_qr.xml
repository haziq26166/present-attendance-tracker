<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0F16">

    <com.example.present.ui.user.qr.StepIndicatorView
        android:id="@+id/stepIndicator"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- STEP 1: QR SCAN -->
    <FrameLayout
        android:id="@+id/layoutQrScan"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/stepIndicator"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinder"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <com.example.present.ui.user.qr.ScanOverlayView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </FrameLayout>

    <!-- STEP 2: GPS CHECK -->
    <LinearLayout
        android:id="@+id/layoutGpsCheck"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/stepIndicator"
        app:layout_constraintBottom_toBottomOf="parent">
        <TextView
            android:id="@+id/tvGpsStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Acquiring GPS..."
            android:textColor="#F0F0F5"
            android:textSize="18sp" />
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/gpsProgress"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:trackThickness="8dp" />
    </LinearLayout>

    <!-- STEP 3: PHOTO CAPTURE -->
    <FrameLayout
        android:id="@+id/layoutPhotoCapture"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/stepIndicator"
        app:layout_constraintBottom_toBottomOf="parent">
        <androidx.camera.view.PreviewView
            android:id="@+id/viewFinderSelfie"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <com.example.present.ui.user.qr.OvalOverlayView
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCapturePhoto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="40dp"
            android:text="Capture Photo" />
        <ProgressBar
            android:id="@+id/photoLoading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- STEP 4: DONE -->
    <LinearLayout
        android:id="@+id/layoutDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/stepIndicator"
        app:layout_constraintBottom_toBottomOf="parent">
        <ImageView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:src="@drawable/ic_verified"
            app:tint="#22C55E" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check-in Successful!"
            android:textColor="#F0F0F5"
            android:textSize="24sp"
            android:layout_marginTop="16dp" />
        <TextView
            android:id="@+id/tvDoneTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#6B6E8E"
            android:layout_marginTop="8dp" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBackHome"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Back to Home" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>