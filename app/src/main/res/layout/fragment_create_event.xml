<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0E0F16">

    <com.example.present.ui.user.qr.StepIndicatorView
        android:id="@+id/stepIndicatorAdmin"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- STEP 1: EVENT DETAILS -->
    <LinearLayout
        android:id="@+id/layoutDetails"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepIndicatorAdmin">

        <EditText android:id="@+id/etEventName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Event Title" android:textColorHint="#6B6E8E" android:textColor="#F0F0F5"/>
        <EditText android:id="@+id/etDescription" android:layout_width="match_parent" android:layout_height="100dp" android:hint="Description" android:gravity="top" android:textColor="#F0F0F5"/>
        <EditText android:id="@+id/etVenueName" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Venue Name" android:textColor="#F0F0F5"/>
        <EditText android:id="@+id/etMaxCapacity" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Capacity" android:inputType="number" android:textColor="#F0F0F5"/>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnPickDate" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Select Date" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_marginTop="10dp"/>
        <TextView android:id="@+id/tvSelectedDate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="No date selected" android:textColor="#6B6E8E" android:layout_gravity="center_horizontal"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:weightSum="2" android:layout_marginTop="10dp">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPickStartTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Start Time" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                <TextView android:id="@+id/tvStartTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="09:00 AM" android:textColor="#F0F0F5"/>
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
                <com.google.android.material.button.MaterialButton android:id="@+id/btnPickEndTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="End Time" style="@style/Widget.MaterialComponents.Button.TextButton"/>
                <TextView android:id="@+id/tvEndTime" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:00 PM" android:textColor="#F0F0F5"/>
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/btnNextStep1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:text="Next: Map"/>
    </LinearLayout>

    <!-- STEP 2: MAP & GEOFENCE -->
    <LinearLayout
        android:id="@+id/layoutMap"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepIndicatorAdmin">

        <!-- Map takes up the top section -->
        <fragment
            android:id="@+id/map_create"
            android:name="com.google.android.gms.maps.SupportMapFragment"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Improvised Control Panel -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardBackgroundColor="#161720"
            app:cardCornerRadius="16dp"
            app:strokeColor="#1E1F2B"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/tvRadiusLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Geofence Radius: 100m"
                    android:textColor="#F0F0F5"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tap map to set venue, then adjust radius below"
                    android:textColor="#6B6E8E"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"/>

                <SeekBar
                    android:id="@+id/seekBarRadius"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="500"
                    android:progress="100"
                    android:progressTint="#7C5CFC"
                    android:thumbTint="#7C5CFC"
                    android:layout_marginTop="16dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnFinalizeEvent"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:layout_marginTop="20dp"
                    app:cornerRadius="12dp"
                    android:text="Confirm Location" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- STEP 3: DONE / SAVE -->
    <LinearLayout
        android:id="@+id/layoutFinal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepIndicatorAdmin">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Event Ready!"
            android:textColor="#F0F0F5"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Please review and save to Firestore."
            android:textColor="#6B6E8E"
            android:layout_marginTop="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveToFirestore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Create Event" />
    </LinearLayout>

    <!-- STEP 4: SUCCESS PAGE -->
    <LinearLayout
        android:id="@+id/layoutSuccess"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/stepIndicatorAdmin">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="120dp"
            android:layout_height="120dp"
            app:cardBackgroundColor="#1A22C55E"
            app:cardCornerRadius="60dp"
            app:cardElevation="0dp"
            app:strokeColor="#22C55E"
            app:strokeWidth="2dp">

            <ImageView
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:src="@android:drawable/checkbox_on_background"
                app:tint="#22C55E" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="Event Created!"
            android:textColor="#F0F0F5"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="Your event has been successfully saved.\nAttendees can now scan the QR code."
            android:textColor="#6B6E8E"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="Tap 'Events' in the menu below to view your list."
            android:textColor="#7C5CFC"
            android:textSize="14sp"
            android:textStyle="italic" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>