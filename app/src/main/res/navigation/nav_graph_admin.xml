<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph_admin"
    app:startDestination="@id/adminHomeFragment">

    <fragment
        android:id="@+id/adminHomeFragment"
        android:name="com.example.present.ui.admin.home.AdminHomeFragment"
        android:label="Admin Home">
        <action
            android:id="@+id/action_adminHome_to_createEvent"
            app:destination="@id/createEventFragment" />
    </fragment>

    <fragment
        android:id="@+id/createEventFragment"
        android:name="com.example.present.ui.admin.create.CreateEventFragment"
        android:label="Create Event">
        <action
            android:id="@+id/action_create_to_list"
            app:destination="@id/eventListFragment" />
    </fragment>

    <fragment
        android:id="@+id/eventListFragment"
        android:name="com.example.present.ui.admin.events.EventListFragment"
        android:label="My Events">

        <!-- Keep your existing action -->
        <action
            android:id="@+id/action_list_to_attendees"
            app:destination="@id/attendeeListFragment" />

        <!-- ADD THIS NEW ACTION HERE -->
        <action
            android:id="@+id/action_list_to_create"
            app:destination="@id/createEventFragment" />

    </fragment>

    <fragment
        android:id="@+id/attendeeListFragment"
        android:name="com.example.present.ui.admin.attendees.AttendeeListFragment"
        android:label="Attendees" />

    <fragment
        android:id="@+id/adminProfileFragment"
        android:name="com.example.present.ui.admin.profile.AdminProfileFragment"
        android:label="Profile" />
</navigation>